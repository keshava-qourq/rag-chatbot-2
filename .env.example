# Copy to .env. Every value points at a service in docker-compose.yml, so a
# fresh clone runs with `docker compose up` and nothing else to configure.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://app:app@db:5432/app

# Redis (as a queue)
REDIS_URL=redis://redis-queue:6379/0

# Uploaded documents. With S3_BUCKET set they go to S3 (credentials from the
# instance/container role, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY); without
# it they are kept on disk under MEDIA_ROOT.
# S3_BUCKET=
# S3_PREFIX=
# MEDIA_ROOT=./data/uploads
